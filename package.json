{
  "name": "FioriElementsRepo",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.3.4",
    "@sap/cds": "^9.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.15.0",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds serve",
    "bindings": "cds bind --to FioriElementsRepo-db && cds bind --to cds bind --to uaa_FioriElementsRepo && cds bind --to FioriElementsRepo-destination-service && cds bind --to FioriElementsRepo-connectivity",
    "watch-listelementreport": "cds watch --open com.list.listelementreport/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy FioriElementsRepo --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "destinations": true,
      "connectivity": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/listelementreport"
  ]
}
